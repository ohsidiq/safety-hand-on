# Salin ke .env.local (tidak pernah di-commit). Hanya nama variabel; nilai rahasia disimpan di
# pengelola rahasia penyedia (Vercel, Supabase, GitHub Secrets). ARCH-009.

# Core API dan worker: koneksi PostgreSQL (lokal atau Supabase staging, peran yang boleh SET ROLE app_authenticated/app_worker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soh_dev

# Core API
API_PORT=8787
# Asal yang diizinkan memanggil Core API (CORS), pisahkan dengan koma
API_ALLOWED_ORIGINS=http://localhost:3000

# Web/PWA (nilai publik)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Worker
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL_MS=2000

# Opsional: sertifikat CA publik penyedia database (PEM) untuk verifikasi TLS penuh. Wajib sebelum data nyata.
DATABASE_CA_CERT=

# SPIKE S-6 (Web Push). Kunci VAPID dibuat dengan `npx web-push generate-vapid-keys`.
# Publik boleh diketahui; PRIVAT hanya di Vercel (Secret), tidak pernah di repo atau chat.
SPIKE_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh.invalid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Autentikasi Core API (M1.2): URL proyek Supabase (bukan rahasia). Token diverifikasi lewat JWKS publik.
SUPABASE_URL=
# Opsional, bawaan: authenticated
AUTH_AUDIENCE=

# Web: login lewat Supabase Auth (M1.4). Publishable key aman di klien; service-role key TIDAK PERNAH di web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
