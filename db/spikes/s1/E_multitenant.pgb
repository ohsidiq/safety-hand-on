\set u random(1, 21)
\set off random(0, 900)
BEGIN;
SELECT set_config('app.user_id', (SELECT user_id::text FROM bench.users WHERE grp='mgr_all' AND n=:u), true);
SELECT id, full_name, job_position FROM worker ORDER BY full_name LIMIT 50 OFFSET :off;
SELECT status, count(*) FROM readiness_snapshot GROUP BY status;
END;
